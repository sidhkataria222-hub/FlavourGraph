# ============================================================
# FlavorGraph AI — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit the .env file to source control.
# ============================================================

# ----- Gemini AI (Google) -----
# Obtain from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ----- JWT Authentication -----
# Must be at least 32 characters of random text
# Generate: openssl rand -base64 48
JWT_SECRET=your_jwt_secret_minimum_32_characters_here

# ----- PostgreSQL (production) -----
# Used when SPRING_PROFILES_ACTIVE=postgres
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/flavorgraph
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your_postgres_password_here

# ----- Spring Profile -----
# Use "default" for H2 in-memory (development), "postgres" for PostgreSQL
SPRING_PROFILES_ACTIVE=default

# ----- Frontend (optional, for Docker) -----
VITE_API_BASE_URL=http://localhost:8080
